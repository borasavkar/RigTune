{
  "name": "rigtune",
  "productName": "RigTune",
  "version": "0.1.4",
  "description": "Ekran kartına, monitöre ve yüklü oyunlara göre sürücü uygulaması ve oyun içi ayar önerileri.",
  "author": "Bora Şavkar",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "test": "node test/run.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "tr.savkar.rigtune",
    "productName": "RigTune",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["src/core/detect/*.ps1"],
    "win": { "target": ["nsis", "portable"], "icon": "src/renderer/assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "RigTune-Kurulum-${version}.exe" },
    "portable": { "artifactName": "RigTune-Tasinabilir-${version}.exe" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "linux": { "target": "AppImage", "category": "Utility" }
  }
}
